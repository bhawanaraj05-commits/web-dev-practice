public class Main {
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    static Node reverseLastK(Node head, int k) {
        if (head == null || k <= 1) {
            return head;
        }

        Node fast = head;

        for (int i = 0; i < k; i++) {
            if (fast == null) {
                return head;
            }
            fast = fast.next;
        }

        Node before = null;
        Node current = head;

        while (fast != null) {
            fast = fast.next;
            before = current;
            current = current.next;
        }

        Node previous = null;

        while (current != null) {
            Node nextNode = current.next;
            current.next = previous;
            previous = current;
            current = nextNode;
        }

        if (before == null) {
            return previous;
        }

        before.next = previous;

        return head;
    }

    static void print(Node head) {
        while (head != null) {
            System.out.print(head.data);
            if (head.next != null) System.out.print(" -> ");
            head = head.next;
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Node head = new Node(10);
        head.next = new Node(20);
        head.next.next = new Node(30);
        head.next.next.next = new Node(40);
        head.next.next.next.next = new Node(50);
        head.next.next.next.next.next = new Node(60);

        Node result = reverseLastK(head, 3);
        print(result);
    }
}
