// Q15. Fix block scope
console.log("\nQ15");
let message;
if (true) { message = "Welcome"; }
console.log(message); // Welcome
// Why: declare the variable outside the block if it is needed outside.

// Q16. Fix loop boundary
console.log("\nQ16");
const prices = [100, 200, 300];
let total = 0;
for (let i = 0; i < prices.length; i++) total += prices[i];
console.log(total); // 600
// Why: valid indexes go from 0 to length - 1; use i < prices.length, not <=.

// Q17. Fix arrow-function this
console.log("\nQ17");
const person = {
    name: "Rahul",
    showName() { console.log(this.name); }
};
person.showName(); // Rahul
// Why: use a regular method when this should refer to the object itself.

// Q18. Coercion
