var outer = 100;
{
    var varValue = 300;
    let letValue = 50;
    console.log(varValue, letValue); // 300 50
}
console.log(varValue, 20); // 300 20 (20 represents the outer let value in the question)
// console.log(letValue); // ReferenceError: letValue is block-scoped
