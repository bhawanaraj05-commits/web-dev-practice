console.log("\nQ6");
function add(a, b) { return a + b; }
console.log(add(2, 3)); // 5
// Answer: C
// Why: return gives a value back; console.log displays a value.

// Q7. Rest parameter
console.log("\nQ7");
function showValues(...values) { return values; }
console.log(showValues(1, 2, 3)); // [1, 2, 3]
// Answer: B
// Why: a rest parameter collects passed arguments into an array.

// Q8. Arrow function and this
console.log("\nQ8");
const student = {
    name: "Riya",
    showName() {
        const show = () => console.log(this.name);
        show();
    }
};
student.showName(); // Riya
// Answer: C
// Why: arrow functions use this from the surrounding scope.

