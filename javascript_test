// Q11. Return values
console.log("\nQ11");
function multiply(a, b) { return a * b; }
console.log(multiply(10, 30)); // 300
function printMessage() { console.log("Hello"); }
console.log(printMessage()); // Hello, then undefined
// Why: if a function doesn't explicitly return a value, it returns undefined.

// Q12. const array mutation
console.log("\nQ12");
const items = ["Milk", "Eggs"];
items.push("Rice", "Oil");
console.log(items);        // ["Milk", "Eggs", "Rice", "Oil"]
console.log(items.length); // 4
// Why: const prevents reassignment of the array variable, not mutation of its contents.

// Q13. this inside an object method
console.log("\nQ13");
const employee = {
    name: "Aman",
    salary: 30000,
    showDetails() { console.log(this.name, this.salary); }
};
employee.showDetails(); // Aman 30000
// Why: this refers to employee when the method is called as employee.showDetails().

// Q14. Rest and spread
console.log("\nQ14");
function count(...values) { return values.length; }
console.log(count("a")); // 1
const first = [1, 2];
const second = [...first, 3, 4];
console.log(second.length); // 4
// Why: rest gathers arguments; spread expands array elements.

